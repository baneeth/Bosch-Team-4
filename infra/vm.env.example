# Copy to infra/vm.env (gitignored) and fill in. Used by scripts/deploy.sh and scripts/run.sh.
# Paths are relative to the repo root.
VM_HOST=<public IP or hostname of your VM>
VM_USER=ubuntu
# SSH private key for the VM (leave empty to use your default ssh key / ssh-agent)
VM_KEY=infra/<your-key>.pem
